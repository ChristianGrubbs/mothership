APP_NAME="The Mothership"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_ADMIN_URL=admin

# Optional PostHog replay; public ingestion identifier only. Export credentials remain server-only.
DAM_POSTHOG_REPLAY_ENABLED=false
DAM_POSTHOG_REPLAY_PUBLIC_KEY=
# Only used where the image names no build commit (MOTHERSHIP_BUILD_COMMIT); see docs/analytics-posthog.md.
DAM_ANALYTICS_RELEASE=

# Initial admin (used by AdminsTableSeeder on first boot only).
# Leave blank to auto-generate a random password and write it to
# storage/app/admin-credentials.txt — read it once, then delete.
# Existing admin rows are NEVER overwritten on re-seed.
INSTALLER_ADMIN_EMAIL=
INSTALLER_ADMIN_PASSWORD=

# Comma-separated list of upstream proxy IPs (or CIDRs) allowed to set
# X-Forwarded-* headers. Use '*' only if your edge already strips these
# headers from the public internet. Defaults to '127.0.0.1' when unset.
TRUSTED_PROXIES=127.0.0.1

# Optional extra hostnames that should be accepted in the Host header
# in addition to APP_URL (comma-separated, no scheme). Subdomains of
# APP_URL are accepted automatically.
TRUSTED_HOSTS=

# CORS for api/* and sanctum/csrf-cookie. Both default to '*' when unset
# (any method / any origin). Restrict origins in production, comma-separated
# with scheme (e.g. https://app.example.com). See config/cors.php.
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_ORIGINS=*

APP_TIMEZONE=UTC
APP_LOCALE=en_US
APP_CURRENCY=USD

# Master switch for admin notifications. Defaults to true when unset.
NOTIFICATIONS_ENABLED=true

# Master switch for the inherited PIM surface. Defaults to false when unset.
MOTHERSHIP_PIM_ENABLED=false

# Master switch for on-demand 360/OSV preview conversion job creation.
# Defaults to false when unset; state inspection and existing proxies work regardless.
MOTHERSHIP_360_PROCESSING_ENABLED=false

# The explorer Library (folders and files together, drag-select). Defaults to true when unset; false serves the classic page.
DAM_EXPLORER_ENABLED=true

DAM_UPLOAD_CONCURRENCY=3
DAM_UPLOAD_MAX_FILE_BYTES=21474836480
DAM_UPLOAD_CHUNK_BYTES=33554432
DAM_UPLOAD_STALE_HOURS=12
DAM_UPLOAD_RETRY_ATTEMPTS=3
DAM_UPLOAD_VERBOSE_LOG=false


VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_CONNECTION=log
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=admin@example.com
MAIL_FROM_NAME=

ADMIN_MAIL_ADDRESS=
ADMIN_MAIL_NAME=

QUEUE_CONNECTION=database

ELASTICSEARCH_ENABLED=
ELASTICSEARCH_CONNECTION=
ELASTICSEARCH_HOST=
ELASTICSEARCH_USER=
ELASTICSEARCH_PASS=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_CLOUD_ID=
ELASTICSEARCH_INDEX_PREFIX=

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000
# REST API requests allowed per minute per client (config/api.php).
REST_API_RATE_LIMIT=120

IMPORT_BATCH_SIZE=1000
IMPORT_BULK_CHUNK_SIZE=500
IMPORT_DEFERRED_INDEXING=false
COMPLETENESS_QUEUE=completeness

GOOGLE_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MOTHERSHIP_AUTH_LOG=true
MOTHERSHIP_PASSWORD_LOGIN=true
MOTHERSHIP_VECTORIZATION_ENABLED=false
MOTHERSHIP_VECTORIZATION_OWNER_ADMIN_ID=
MOTHERSHIP_VECTORIZER_API_ID=
MOTHERSHIP_VECTORIZER_API_SECRET=
MOTHERSHIP_OPTIMIZER_API=
# Home Video Downloader: the Studio video service (docs/ops/studio-video.md). Unset hides the tool.
MOTHERSHIP_HOME_VIDEO_API=
# Signal/Trending feed adapter base URL (docs/rss-ticker.md). Unset leaves the Signal and Trending widgets in their unavailable state.
MOTHERSHIP_HOME_RSS_API=
# Trending adapter base URL; unset falls back to MOTHERSHIP_HOME_RSS_API.
MOTHERSHIP_HOME_TRENDING_API=
# Icon library (Iconvault) base URL, e.g. https://icons.example.org (docs/iconvault-api.md). Unset hides the Icon Library card, link and dialog.
MOTHERSHIP_ICON_LIBRARY_URL=
# Origin the RSS sidecar (tools/rss/server.py) accepts browser calls from. Unset allows only the local preview origins.
MOTHERSHIP_ASSETS_ORIGIN=
# MOTHERSHIP_OPTIMIZER_MAX_BYTES=2147483648
# VECTORIZATION_QUEUE_RETRY_AFTER=1200

# Asset bytes on an S3-compatible store such as Garage, MinIO, R2 or AWS (docs/ops/object-storage.md, ADR 0017).
# Unset keeps them on the local `private` disk. Keep FILESYSTEM_DISK as it is: logos and avatars use it.
# MOTHERSHIP_ASSET_DISK=s3
# AWS_ENDPOINT=https://storage-host
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_DEFAULT_REGION=us-east-1   # must match the store's region (Garage checks it)
# AWS_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# nginx streams remote blobs same-origin through this internal location (dockerfiles/nginx.conf).
# MOTHERSHIP_REMOTE_ACCEL_PREFIX=/__dam_remote
# With a remote asset disk, uploads stage here and stay as warm copies for the first preview jobs.
# MOTHERSHIP_STAGING_ROOT=/path/to/mothership-staging
# MOTHERSHIP_STAGING_KEEP_HOURS=6
