#!/usr/bin/env python3
"""A stand-in for the docker CLI, covering only the calls deploy/linux-host/backup.sh makes when it creates a set.

FAKE_DOCKER_STATE names a folder for its counters. FAKE_DOCKER_CP_FAIL=1 makes `docker cp` leave a partial file and fail.
"""
import os
import sys

args = sys.argv[1:]
state = os.environ["FAKE_DOCKER_STATE"]


def lastsave(bump: bool = False) -> int:
    path = os.path.join(state, "lastsave")
    value = int(open(path).read()) if os.path.exists(path) else 1000
    if bump:
        value += 1
        with open(path, "w") as handle:
            handle.write(str(value))
    return value


if args[:1] == ["cp"]:
    failing = os.environ.get("FAKE_DOCKER_CP_FAIL") == "1"
    with open(args[2], "wb") as handle:
        handle.write(b"REDIS0011" + b"\0" * (8 if failing else 64))
    sys.exit(1 if failing else 0)

if args[:1] == ["exec"]:
    rest = [arg for arg in args[1:] if arg != "-i"]
    command = rest[1:]
    if command[:1] == ["redis-cli"]:
        request = " ".join(command[1:])
        if request == "LASTSAVE":
            print(lastsave())
        elif request == "BGSAVE":
            lastsave(bump=True)
            print("Background saving started")
        else:
            print({
                "CONFIG GET dir": "dir\n/data",
                "CONFIG GET dbfilename": "dbfilename\ndump.rdb",
                "INFO persistence": "# Persistence\r\nrdb_last_bgsave_status:ok\r",
                "INFO keyspace": "# Keyspace\r\ndb0:keys=2,expires=0,avg_ttl=0\r",
            }[request])
        sys.exit(0)
    script = command[2] if command[:2] == ["sh", "-c"] else ""
    if "pg_dump" in script:
        sys.stdout.buffer.write(b"PGDMP fake custom-format dump")
        sys.exit(0)
    if "psql" in script:
        sys.stdin.read()
        print("dam_assets\t3\nfolders\t5")
        sys.exit(0)

sys.exit(f"fake docker: unsupported call {args}")
